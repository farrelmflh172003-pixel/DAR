# Menkopolkam AI Hub Configuration
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Real-Time Voice Model Configuration
OPENAI_REALTIME_MODEL=gpt-realtime-mini
GEMINI_LIVE_MODEL=models/gemini-2.0-flash-exp
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts

# Mock Fallback Control (set to true only for offline mock testing)
ENABLE_REALTIME_MOCK=false

# Server Network & Security Settings
ENV=development
HOST=127.0.0.1
PORT=8000

# Authentication & Access Control
AUTH_ENABLED=true
ALLOW_ANONYMOUS_DEV=false
JWT_SECRET_KEY=generate_a_secure_random_32_byte_secret_for_production
JWT_ALGORITHM=HS256
JWT_ISSUER=menkopolkam-ai-hub
JWT_AUDIENCE=menkopolkam-web
TICKET_TTL_SECONDS=60
MAX_CONCURRENT_SESSIONS_PER_USER=2
MAX_FAILED_HANDSHAKES_PER_IP=10
SESSION_IDLE_TIMEOUT_SECONDS=120
TRUSTED_PROXIES=127.0.0.1,::1
RATE_LIMIT_SWITCH_PROVIDER=5
