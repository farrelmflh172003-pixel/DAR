# ========================================================
# MENKOPOLKAM AI HUB - Environment Configuration Template
# ========================================================

# Application Mode: development | staging | production
ENV=production

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# AI Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# AI Models Configuration
GEMINI_LIVE_MODEL=models/gemini-2.0-flash-exp
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
OPENAI_REALTIME_MODEL=gpt-realtime-mini

# Database (MariaDB / MySQL) Configuration (Optional - falls back to secure JSON storage if not connected)
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=root
MARIADB_PASSWORD=your_mariadb_password
MARIADB_DATABASE=menkopolkam_ai_hub

# Security & Authentication
# In production, generate a secure random 32+ character key: openssl rand -hex 32
JWT_SECRET_KEY=menkopolkam_production_secure_secret_key_change_me_32bytes_min!
JWT_ALGORITHM=HS256
AUTH_ENABLED=true
ALLOW_ANONYMOUS_DEV=false
TICKET_TTL_SECONDS=60
SESSION_IDLE_TIMEOUT_SECONDS=180

# CORS Origins (Comma-separated for multiple origins, or * for open deployment)
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

